## Sheet 3 — Summary Dashboard

```python
ws3 = wb.create_sheet("Summary")

# Title bar
ws3.merge_cells("A1:E1")
title_cell = ws3["A1"]
title_cell.value = "[Project] — Jira Backlog Summary"
title_cell.font = Font(bold=True, size=16, color="FFFFFF", name="Arial")
title_cell.fill = hfill(NAVY)
title_cell.alignment = Alignment(horizontal="center", vertical="center")
ws3.row_dimensions[1].height = 38

# Epic breakdown section
ws3["A3"] = "Epic Breakdown"
ws3["A3"].font = Font(bold=True, size=12, color=NAVY, name="Arial")

epic_headers = ["Epic", "Stories", "Story Points", "Phase", "Component"]
epic_widths   = [35, 10, 14, 12, 22]

# Compute stats from data
from collections import defaultdict
epic_stats = defaultdict(lambda: {"stories": 0, "points": 0, "phase": "", "component": ""})
current_epic = ""
for row in data:
    if row["Issue Type"] == "Epic":
        current_epic = row["Epic Name"]
        epic_stats[current_epic]["component"] = row["Component/s"]
    else:
        epic_stats[current_epic]["stories"] += 1
        try:
            epic_stats[current_epic]["points"] += int(row["Story Points"] or 0)
        except:
            pass
        if not epic_stats[current_epic]["phase"] and row["Fix Version/s"]:
            epic_stats[current_epic]["phase"] = row["Fix Version/s"]

# Write epic table
sum_row = 5
total_stories = 0
total_points = 0
epic_color_idx = 0

for epic_name, stats in epic_stats.items():
    bg, fg = EPIC_PALETTE[epic_color_idx % len(EPIC_PALETTE)]
    epic_color_idx += 1
    vals = [epic_name, stats["stories"], stats["points"], stats["phase"], stats["component"]]
    for col, val in enumerate(vals, 1):
        cell = ws3.cell(row=sum_row, column=col, value=val)
        cell.fill = hfill(bg)
        cell.font = rfont(fg, 10)
        cell.border = thin_border()
        cell.alignment = wrap_align("center" if col > 1 else "left")
    total_stories += stats["stories"]
    total_points += stats["points"]
    ws3.row_dimensions[sum_row].height = 22
    sum_row += 1

# Totals row
for col, val in enumerate(["TOTAL", total_stories, total_points, "", ""], 1):
    cell = ws3.cell(row=sum_row, column=col, value=val)
    cell.font = bfont()
    cell.fill = hfill(NAVY)
    cell.border = thin_border()
    cell.alignment = wrap_align("center" if col > 1 else "left")
ws3.row_dimensions[sum_row].height = 24

# Phase breakdown
sum_row += 2
ws3.cell(row=sum_row, column=1, value="Stories by Phase").font = Font(bold=True, size=12, color=NAVY, name="Arial")
sum_row += 1

PHASE_BG = {"Phase 1": "D6E4F7", "Phase 2": "D5F5E3", "Phase 3": "FDEBD0", "Sprint 1": "D6E4F7"}
phase_stats = defaultdict(lambda: {"stories": 0, "points": 0})
for row in data:
    if row["Issue Type"] == "Story":
        ph = row["Fix Version/s"] or "Unassigned"
        phase_stats[ph]["stories"] += 1
        try:
            phase_stats[ph]["points"] += int(row["Story Points"] or 0)
        except:
            pass

for ph, stats in phase_stats.items():
    for col, val in enumerate([ph, stats["stories"], stats["points"]], 1):
        cell = ws3.cell(row=sum_row, column=col, value=val)
        cell.fill = hfill(PHASE_BG.get(ph, "F2F2F2"))
        cell.font = rfont("111111", 10)
        cell.border = thin_border()
        cell.alignment = wrap_align("center" if col > 1 else "left")
    ws3.row_dimensions[sum_row].height = 20
    sum_row += 1
```

