## Sheet 1 — Jira Import

```python
ws1 = wb.active
ws1.title = "Jira Import"

HEADERS = ["Issue Type","Summary","Description","Epic Name","Epic Link",
           "Priority","Story Points","Labels","Fix Version/s",
           "Acceptance Criteria","Component/s","Reporter"]
COL_WIDTHS = [14, 52, 60, 30, 30, 10, 12, 28, 12, 58, 20, 22]

# Header row
for col, (h, w) in enumerate(zip(HEADERS, COL_WIDTHS), 1):
    cell = ws1.cell(row=1, column=col, value=h)
    cell.font = bfont()
    cell.fill = hfill(NAVY)
    cell.alignment = wrap_align("center")
    cell.border = thin_border()
    ws1.column_dimensions[get_column_letter(col)].width = w
ws1.row_dimensions[1].height = 28
ws1.freeze_panes = "A2"

# Data rows
epic_color_idx = 0
current_epic_bg = "F2F2F2"
current_epic_fg = "111111"

for row_idx, row in enumerate(data, 2):
    if row["Issue Type"] == "Epic":
        bg, fg = EPIC_PALETTE[epic_color_idx % len(EPIC_PALETTE)]
        current_epic_bg, current_epic_fg = bg, fg
        epic_color_idx += 1

    for col, h in enumerate(HEADERS, 1):
        val = row.get(h, "")
        cell = ws1.cell(row=row_idx, column=col, value=val)
        cell.border = thin_border()
        cell.alignment = wrap_align()

        if row["Issue Type"] == "Epic":
            cell.fill = hfill(current_epic_bg)
            cell.font = bfont(current_epic_fg, 10)
        elif h == "Priority":
            cell.fill = hfill(PRIORITY_COLORS.get(str(val), "F2F2F2"))
            cell.font = bfont("111111", 9)
        else:
            cell.fill = hfill("FAFAFA")
            cell.font = rfont()
    ws1.row_dimensions[row_idx].height = 38

ws1.auto_filter.ref = f"A1:{get_column_letter(len(HEADERS))}1"
```

