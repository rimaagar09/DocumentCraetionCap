## Sheet 2 — Backlog View

```python
ws2 = wb.create_sheet("Backlog View")
BK_HEADERS = ["Epic","Type","Ticket ID","User Story","Priority","Pts","Phase","Component","Acceptance Criteria"]
BK_WIDTHS   = [30, 10, 14, 55, 10, 6, 10, 20, 55]

# Header row (same pattern as Sheet 1)

# Data rows
epic_color_idx = 0
current_epic = ""
current_epic_bg = "F2F2F2"
current_epic_fg = "111111"
row_num = 2

for row in data:
    if row["Issue Type"] == "Epic":
        current_epic = row["Epic Name"]
        bg, fg = EPIC_PALETTE[epic_color_idx % len(EPIC_PALETTE)]
        current_epic_bg, current_epic_fg = bg, fg
        epic_color_idx += 1

        # Epic header row — full-width colour bar
        for col in range(1, len(BK_HEADERS) + 1):
            cell = ws2.cell(row=row_num, column=col)
            cell.fill = hfill(current_epic_bg)
            cell.font = bfont(current_epic_fg, 10)
            cell.border = thin_border()
            cell.alignment = wrap_align()
        ws2.cell(row=row_num, column=1, value=current_epic)
        ws2.cell(row=row_num, column=2, value="Epic")
        ws2.cell(row=row_num, column=4, value=row["Summary"])
        ws2.cell(row=row_num, column=5, value=row["Priority"])
        ws2.cell(row=row_num, column=8, value=row["Component/s"])
        ws2.row_dimensions[row_num].height = 24
        row_num += 1

    else:
        # Extract ticket ID from [FR-001] prefix
        summary = row["Summary"]
        ticket_id = ""
        if summary.startswith("["):
            end = summary.find("]")
            if end > 0:
                ticket_id = summary[1:end]
                summary = summary[end + 2:]

        vals = [current_epic, "Story", ticket_id, summary,
                row["Priority"], row["Story Points"] or "",
                row["Fix Version/s"], row["Component/s"],
                row["Acceptance Criteria"]]

        for col, val in enumerate(vals, 1):
            cell = ws2.cell(row=row_num, column=col, value=val)
            cell.border = thin_border()
            cell.alignment = wrap_align()
            if col == 5:  # Priority column
                cell.fill = hfill(PRIORITY_COLORS.get(str(val), "F2F2F2"))
                cell.font = bfont("111111", 9)
            else:
                cell.fill = hfill("FAFAFA")
                cell.font = rfont()
        ws2.row_dimensions[row_num].height = 42
        row_num += 1

ws2.auto_filter.ref = f"A1:{get_column_letter(len(BK_HEADERS))}1"
```

