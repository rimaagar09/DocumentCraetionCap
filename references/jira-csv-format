## Python Generation Template

```python
import csv

HEADERS = [
    "Issue Type", "Summary", "Description", "Epic Name", "Epic Link",
    "Priority", "Story Points", "Labels", "Fix Version/s",
    "Acceptance Criteria", "Component/s", "Reporter"
]

def epic(name, summary, priority="High", label="", component="", reporter="BA Team"):
    return {
        "Issue Type": "Epic", "Summary": summary, "Description": "",
        "Epic Name": name, "Epic Link": "", "Priority": priority,
        "Story Points": "", "Labels": label, "Fix Version/s": "",
        "Acceptance Criteria": "", "Component/s": component, "Reporter": reporter
    }

def story(epic_name, summary, description, ac, priority="Medium",
          points=3, label="", version="Phase 1", component="", reporter="BA Team"):
    return {
        "Issue Type": "Story", "Summary": summary, "Description": description,
        "Epic Name": "", "Epic Link": epic_name, "Priority": priority,
        "Story Points": points, "Labels": label, "Fix Version/s": version,
        "Acceptance Criteria": ac, "Component/s": component, "Reporter": reporter
    }

rows = []
# Add epics and stories...

with open("output.csv", "w", newline="", encoding="utf-8") as f:
    writer = csv.DictWriter(f, fieldnames=HEADERS)
    writer.writeheader()
    writer.writerows(rows)
```

